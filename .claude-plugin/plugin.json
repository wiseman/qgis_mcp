{
  "name": "qgis-mcp",
  "displayName": "QGIS MCP",
  "description": "Control QGIS from Claude: load projects, manage layers, run processing algorithms, render maps, and execute PyQGIS code.",
  "version": "0.1.0",
  "author": {
    "name": "John Wiseman",
    "email": "jjwiseman@gmail.com"
  },
  "homepage": "https://github.com/wiseman/qgis_mcp",
  "mcpServers": {
    "qgis": {
      "command": "uv",
      "args": [
        "run",
        "${CLAUDE_PLUGIN_ROOT}/src/qgis_mcp/qgis_mcp_server.py"
      ]
    }
  }
}
